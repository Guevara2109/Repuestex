<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Repuestex</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="rx-nav" id="rxNav">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="rx-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-gear-wide-connected" aria-hidden="true"></i> REPUESTEX
            </a>
            <div class="d-flex align-items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="rx-user d-none d-sm-inline"><i class="bi bi-person-circle" aria-hidden="true"></i> @User.Identity.Name</span>
                    if (User.IsInRole("Administrador"))
                    {
                        <a class="btn-ghost" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2" aria-hidden="true"></i> Administración</a>
                    }
                    <form asp-controller="Cuenta" asp-action="Logout" method="post" class="m-0">
                        <button class="btn btn-rx btn-sm"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Cerrar sesión</button>
                    </form>
                }
                else
                {
                    <a class="btn-ghost" asp-controller="Cuenta" asp-action="Login"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Ingresar</a>
                    <a class="btn btn-rx btn-sm" asp-controller="Cuenta" asp-action="Registro">Registrarse</a>
                }
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="rx-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span><strong>Repuestex</strong> · Consulta de repuestos automotrices</span>
            <span>Nissan · Toyota · Mitsubishi · Hyundai · Kia (2008-2026)</span>
        </div>
    </footer>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="rx-toasts"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
