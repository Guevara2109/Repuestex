@model ResultadosViewModel
@{
    ViewData["Title"] = "Resultados";
    var f = Model.Filtro;
}

<form method="get" asp-controller="Repuestos" asp-action="Buscar">
    <input type="hidden" name="IdMarca" value="@f.IdMarca" />
    <input type="hidden" name="IdModelo" value="@f.IdModelo" />
    <input type="hidden" name="Anio" value="@f.Anio" />
    <input type="hidden" name="IdVehiculo" value="@f.IdVehiculo" />
    <input type="hidden" name="Q" value="@f.Q" />

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h1 class="h5 mb-0">
                @(string.IsNullOrEmpty(Model.Titulo) ? "Resultados" : "Resultados para: ")<strong>@Model.Titulo</strong>
            </h1>
            <span class="text-muted small">@Model.Total resultado(s)</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="small" for="Orden">Ordenar:</label>
            <select id="Orden" name="Orden" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(f.Orden))">Nombre: A-Z</option>
                <option value="nombre_desc" selected="@(f.Orden == "nombre_desc")">Nombre: Z-A</option>
                <option value="precio_asc" selected="@(f.Orden == "precio_asc")">Precio: menor a mayor</option>
                <option value="precio_desc" selected="@(f.Orden == "precio_desc")">Precio: mayor a menor</option>
            </select>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h6 fw-bold">FILTROS</h2>
                    <hr class="my-2" />

                    <p class="small fw-bold mb-1">Categoría</p>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="IdCategoria" id="cat-todas" value=""
                               checked="@(f.IdCategoria is null)" />
                        <label class="form-check-label small" for="cat-todas">Todas</label>
                    </div>
                    @foreach (var c in Model.Categorias)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="IdCategoria" id="cat-@c.IdCategoria"
                                   value="@c.IdCategoria" checked="@(f.IdCategoria == c.IdCategoria)" />
                            <label class="form-check-label small" for="cat-@c.IdCategoria">@c.Nombre</label>
                        </div>
                    }

                    <p class="small fw-bold mt-3 mb-1">Tipo</p>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="Tipo" id="tipo-todos" value=""
                               checked="@(string.IsNullOrEmpty(f.Tipo))" />
                        <label class="form-check-label small" for="tipo-todos">Todos</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="Tipo" id="tipo-orig" value="Original"
                               checked="@(f.Tipo == "Original")" />
                        <label class="form-check-label small" for="tipo-orig">Original</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="Tipo" id="tipo-alt" value="Alterno"
                               checked="@(f.Tipo == "Alterno")" />
                        <label class="form-check-label small" for="tipo-alt">Alterno</label>
                    </div>

                    <p class="small fw-bold mt-3 mb-1">Disponibilidad</p>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="EnStock" id="en-stock" value="true"
                               checked="@(f.EnStock)" />
                        <label class="form-check-label small" for="en-stock">En stock</label>
                    </div>

                    <button class="btn btn-sm btn-warning w-100 mt-3">Aplicar filtros</button>
                    <a class="btn btn-sm btn-link w-100" asp-controller="Home" asp-action="Index">Nueva búsqueda</a>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            @if (Model.Items.Count == 0)
            {
                <div class="alert alert-warning">
                    <strong>Sin resultados.</strong> Prueba cambiando la versión, la categoría o los filtros.
                </div>
            }
            else
            {
                foreach (var r in Model.Items)
                {
                    <div class="card shadow-sm mb-2">
                        <div class="card-body d-flex align-items-center gap-3">
                            @if (!string.IsNullOrEmpty(r.ImagenUrl))
                            {
                                <img src="@r.ImagenUrl" alt="@r.Nombre" style="width:80px;height:60px;object-fit:cover" />
                            }
                            else
                            {
                                <div class="bg-secondary-subtle text-muted small d-flex align-items-center justify-content-center"
                                     style="width:80px;height:60px">[Foto]</div>
                            }
                            <div class="flex-grow-1">
                                <div class="fw-bold">@r.Nombre</div>
                                <div class="small text-muted">
                                    N.º parte: <strong>@r.NumeroParte</strong>
                                    <span class="badge @(r.Tipo == "Original" ? "text-bg-success" : "text-bg-danger")">@r.Tipo</span>
                                    · @r.Categoria
                                </div>
                                @if (r.PrecioDesde is decimal precio)
                                {
                                    <div class="small fw-bold @((r.StockTotal ?? 0) > 0 ? "text-success" : "text-danger")">
                                        ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
                                        - @((r.StockTotal ?? 0) > 0 ? "Disponible" : "Agotado")
                                    </div>
                                }
                                else
                                {
                                    <div class="small text-muted">Sin precio registrado</div>
                                }
                            </div>
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Repuestos" asp-action="Detalle" asp-route-id="@r.IdRepuesto">Ver</a>
                        </div>
                    </div>
                }

                @if (Model.TotalPaginas > 1)
                {
                    <nav class="mt-3">
                        <ul class="pagination pagination-sm">
                            @for (int i = 1; i <= Model.TotalPaginas; i++)
                            {
                                <li class="page-item @(i == Model.Pagina ? "active" : "")">
                                    <button type="submit" name="Pagina" value="@i" class="page-link">@i</button>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</form>
