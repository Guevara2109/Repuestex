@model RegistroViewModel
@{
    ViewData["Title"] = "Registrarse";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="rx-auth">
                <div class="rx-auth-head">
                    <div class="rx-auth-ico"><i class="bi bi-person-plus" aria-hidden="true"></i></div>
                    <h1>Crear cuenta</h1>
                    <p>Solo toma un minuto.</p>
                </div>
                <form asp-action="Registro" method="post" novalidate data-loading>
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person" aria-hidden="true"></i></span>
                            <input asp-for="Nombre" class="form-control" autocomplete="name" />
                        </div>
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                            <input asp-for="Correo" class="form-control" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Contrasena" class="form-label small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock" aria-hidden="true"></i></span>
                            <input asp-for="Contrasena" class="form-control" autocomplete="new-password" />
                            <button type="button" class="btn" data-toggle-password aria-label="Mostrar contraseña"><i class="bi bi-eye" aria-hidden="true"></i></button>
                        </div>
                        <div class="rx-meter"><div id="pwBar"></div></div>
                        <div class="small text-secondary mt-1" id="pwTxt" style="min-height:1.2em"></div>
                        <span asp-validation-for="Contrasena" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmarContrasena" class="form-label small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill" aria-hidden="true"></i></span>
                            <input asp-for="ConfirmarContrasena" class="form-control" autocomplete="new-password" />
                            <button type="button" class="btn" data-toggle-password aria-label="Mostrar contraseña"><i class="bi bi-eye" aria-hidden="true"></i></button>
                        </div>
                        <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                    </div>
                    <button class="btn btn-rx w-100">Crear cuenta</button>
                </form>
                <p class="text-center small mt-3 mb-0">
                    ¿Ya tienes cuenta? <a asp-action="Login">Ingresa</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var pw = document.getElementById('Contrasena');
            var barra = document.getElementById('pwBar');
            var texto = document.getElementById('pwTxt');
            var niveles = ['', 'Débil', 'Regular', 'Buena', 'Fuerte'];
            var colores = ['#dee2e6', '#dc3545', '#fd7e14', '#ffc107', '#198754'];
            pw.addEventListener('input', function () {
                var v = pw.value;
                var s = 0;
                if (v.length >= 8) s++;
                if (/[A-Z]/.test(v) && /[a-z]/.test(v)) s++;
                if (/\d/.test(v)) s++;
                if (/[^A-Za-z0-9]/.test(v)) s++;
                barra.style.width = (s * 25) + '%';
                barra.style.background = colores[s];
                texto.textContent = v ? 'Seguridad: ' + niveles[s] : '';
            });
        })();
    </script>
}
