@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            @if (TempData["Mensaje"] is string mensaje)
            {
                <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i> @mensaje
                </div>
            }
            <div class="rx-auth">
                <div class="rx-auth-head">
                    <div class="rx-auth-ico"><i class="bi bi-person-circle" aria-hidden="true"></i></div>
                    <h1>Iniciar sesión</h1>
                    <p>Entra a tu cuenta de Repuestex.</p>
                </div>
                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate data-loading>
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                            <input asp-for="Correo" class="form-control" placeholder="usuario@ejemplo.com" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Contrasena" class="form-label small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock" aria-hidden="true"></i></span>
                            <input asp-for="Contrasena" class="form-control" autocomplete="current-password" />
                            <button type="button" class="btn" data-toggle-password aria-label="Mostrar contraseña"><i class="bi bi-eye" aria-hidden="true"></i></button>
                        </div>
                        <span asp-validation-for="Contrasena" class="text-danger small"></span>
                    </div>
                    <button class="btn btn-rx w-100">Ingresar</button>
                </form>
                <p class="text-center small mt-3 mb-0">
                    ¿No tienes cuenta? <a asp-action="Registro">Regístrate</a>
                </p>
            </div>
        </div>
    </div>
</div>
