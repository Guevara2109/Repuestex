@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="alert alert-success">@mensaje</div>
        }
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h4 mb-3">Iniciar sesión</h1>
                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label"></label>
                        <input asp-for="Correo" class="form-control" placeholder="usuario@ejemplo.com" />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Contrasena" class="form-label"></label>
                        <input asp-for="Contrasena" class="form-control" />
                        <span asp-validation-for="Contrasena" class="text-danger small"></span>
                    </div>
                    <button class="btn btn-warning w-100">INGRESAR</button>
                </form>
                <p class="text-center small mt-3 mb-0">
                    ¿No tienes cuenta? <a asp-action="Registro">Regístrate</a>
                </p>
            </div>
        </div>
    </div>
</div>
