@{
    ViewData["Title"] = "Administración";
}

<div class="container py-4">
    <h1 class="h4 fw-bold mb-1">Panel administrativo</h1>
    <p class="text-secondary mb-4">
        Gestiona el catálogo del sistema.
    </p>

    <div class="row g-3">

        <div class="col-6 col-lg-4">
            <a asp-controller="Admin"
               asp-action="Repuestos"
               class="rx-module d-block text-decoration-none text-reset h-100">
                <i class="bi bi-tools" aria-hidden="true"></i>
                <h2 class="h6 fw-bold mt-2 mb-1">Repuestos</h2>
                <p class="small text-secondary mb-0">
                    Listar, editar, activar y desactivar.
                </p>
            </a>
        </div>

        <div class="col-6 col-lg-4">
            <a asp-controller="AdminExtras"
               asp-action="Vehiculos"
               class="rx-module d-block text-decoration-none text-reset h-100">
                <i class="bi bi-car-front" aria-hidden="true"></i>
                <h2 class="h6 fw-bold mt-2 mb-1">Vehículos</h2>
                <p class="small text-secondary mb-0">
                    Gestionar vehículos y sus características.
                </p>
            </a>
        </div>

        <div class="col-6 col-lg-4">
            <a asp-controller="AdminExtras"
               asp-action="Proveedores"
               class="rx-module d-block text-decoration-none text-reset h-100">
                <i class="bi bi-shop" aria-hidden="true"></i>
                <h2 class="h6 fw-bold mt-2 mb-1">Proveedores</h2>
                <p class="small text-secondary mb-0">
                    Crear, editar, activar y desactivar proveedores.
                </p>
            </a>
        </div>

        <div class="col-6 col-lg-4">
            <a asp-controller="AdminExtras"
               asp-action="Usuarios"
               class="rx-module d-block text-decoration-none text-reset h-100">
                <i class="bi bi-people" aria-hidden="true"></i>
                <h2 class="h6 fw-bold mt-2 mb-1">Usuarios</h2>
                <p class="small text-secondary mb-0">
                    Administrar roles y estados de cuentas.
                </p>
            </a>
        </div>

        <div class="col-6 col-lg-4">
            <a asp-controller="AdminExtras"
               asp-action="ImportarCsv"
               class="rx-module d-block text-decoration-none text-reset h-100">
                <i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i>
                <h2 class="h6 fw-bold mt-2 mb-1">Importar CSV</h2>
                <p class="small text-secondary mb-0">
                    Importar proveedores desde archivos CSV.
                </p>
            </a>
        </div>

        <div class="col-6 col-lg-4">
            <a asp-controller="AdminExtras"
               asp-action="Reportes"
               class="rx-module d-block text-decoration-none text-reset h-100">
                <i class="bi bi-bar-chart" aria-hidden="true"></i>
                <h2 class="h6 fw-bold mt-2 mb-1">Reportes y bitácora</h2>
                <p class="small text-secondary mb-0">
                    Consultar estadísticas y registros de auditoría.
                </p>
            </a>
        </div>

    </div>
</div>
