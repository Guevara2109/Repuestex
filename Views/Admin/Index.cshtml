@{
    ViewData["Title"] = "Administración";
}
<div class="container py-4">
    <h1 class="h4 fw-bold mb-1">Panel administrativo</h1>
    <p class="text-secondary mb-4">Gestiona el catálogo del sistema.</p>
    <div class="row g-3">
        <div class="col-6 col-lg-4">
            <a asp-controller="Admin" asp-action="Repuestos" class="rx-module d-block text-decoration-none text-reset h-100">
                <i class="bi bi-tools" aria-hidden="true"></i>
                <h2 class="h6 fw-bold mt-2 mb-1">Repuestos</h2>
                <p class="small text-secondary mb-0">Listar, editar, activar y desactivar.</p>
            </a>
        </div>
        @foreach (var modulo in new[] {
            (Icono: "bi-car-front", Nombre: "Vehículos", Texto: "Marcas, modelos y versiones"),
            (Icono: "bi-shop", Nombre: "Proveedores", Texto: "Precios y existencias"),
            (Icono: "bi-people", Nombre: "Usuarios", Texto: "Cuentas y roles"),
            (Icono: "bi-file-earmark-spreadsheet", Nombre: "Importar CSV", Texto: "Carga masiva de datos"),
            (Icono: "bi-bar-chart", Nombre: "Reportes y bitácora", Texto: "Consultas y auditoría")
        })
        {
            <div class="col-6 col-lg-4">
                <div class="rx-module h-100">
                    <i class="bi @modulo.Icono" aria-hidden="true"></i>
                    <h2 class="h6 fw-bold mt-2 mb-1">@modulo.Nombre</h2>
                    <p class="small text-secondary mb-0">@modulo.Texto</p>
                    <span class="badge bg-secondary mt-2">Pendiente</span>
                </div>
            </div>
        }
    </div>
</div>
