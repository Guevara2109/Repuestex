@{
    ViewData["Title"] = "Administración";
}
<div class="container py-4">
    <h1 class="h4 fw-bold mb-1">Panel administrativo</h1>
    <p class="text-secondary mb-4">Aquí se gestionará el catálogo del sistema. Estos módulos se activarán en los siguientes avances.</p>
    <div class="row g-3">
        <div class="col-6 col-lg-4"><div class="rx-module"><i class="bi bi-tools" aria-hidden="true"></i><h2 class="h6 fw-bold mt-2 mb-1">Repuestos</h2><p class="small text-secondary mb-0">Crear, editar y desactivar (CU-09).</p></div></div>
        <div class="col-6 col-lg-4"><div class="rx-module"><i class="bi bi-car-front" aria-hidden="true"></i><h2 class="h6 fw-bold mt-2 mb-1">Vehículos</h2><p class="small text-secondary mb-0">Marcas, modelos y versiones (CU-11).</p></div></div>
        <div class="col-6 col-lg-4"><div class="rx-module"><i class="bi bi-shop" aria-hidden="true"></i><h2 class="h6 fw-bold mt-2 mb-1">Proveedores</h2><p class="small text-secondary mb-0">Precios y existencias (CU-10).</p></div></div>
        <div class="col-6 col-lg-4"><div class="rx-module"><i class="bi bi-people" aria-hidden="true"></i><h2 class="h6 fw-bold mt-2 mb-1">Usuarios</h2><p class="small text-secondary mb-0">Cuentas y roles (CU-12).</p></div></div>
        <div class="col-6 col-lg-4"><div class="rx-module"><i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i><h2 class="h6 fw-bold mt-2 mb-1">Importar CSV</h2><p class="small text-secondary mb-0">Carga masiva de datos (CU-13).</p></div></div>
        <div class="col-6 col-lg-4"><div class="rx-module"><i class="bi bi-bar-chart" aria-hidden="true"></i><h2 class="h6 fw-bold mt-2 mb-1">Reportes y bitácora</h2><p class="small text-secondary mb-0">Consultas frecuentes y auditoría (CU-14).</p></div></div>
    </div>
</div>
